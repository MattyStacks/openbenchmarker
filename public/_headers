# Cloudflare Workers Static Assets response headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite puts content-hashed bundles here, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Preview hosts (share-results.opengpubenchmarker.com, <id>-share-results...) stay out of search.
# workers.dev Previews get this from Cloudflare; custom-domain Previews do not. The apex never matches.
https://:preview.opengpubenchmarker.com/*
  X-Robots-Tag: noindex
